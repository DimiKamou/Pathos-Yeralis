# ─────────────────────────────────────────────────────────────────────────────
# PATHOS by Yeralis — environment template. Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──
# DEFAULT: SQLite — zero-config, fully offline. Nothing to install.
DATABASE_URL="file:./dev.db"
#
# PRODUCTION (Vercel / Firebase App Hosting + Cloud SQL): use Postgres.
#   1) in prisma/schema.prisma set:  provider = "postgresql"
#   2) set DATABASE_URL to your connection string, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pathos?schema=public"
# (A local Postgres is also available via `npm run db:up` + docker-compose.yml.)

# ── Admin auth ──
# Seeded into the AdminUser table by `npm run db:seed`. Storefront stays guest.
ADMIN_EMAIL="admin@pathos-yeralis.gr"
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Use a long random string:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET="generate-a-long-random-secret"

# ── Stripe (TEST MODE for the alpha) ──
# Get keys at https://dashboard.stripe.com/test/apikeys
# Leave ALL blank to run bank-transfer-only (card + Apple/Google Pay hidden).
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From `stripe listen` or the dashboard webhook endpoint (payment_intent.succeeded).
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── Email (Resend) ──
# https://resend.com/api-keys — blank → dev "console" provider just logs sends.
RESEND_API_KEY=""
EMAIL_FROM="PATHOS by Yeralis <hello@pathos-yeralis.gr>"
# Where new-order alerts are sent (the owner's inbox). Falls back to ADMIN_EMAIL.
ORDER_NOTIFY_EMAIL=""

# ── Bank transfer / deposit details (shown at checkout) ──
# Placeholders from pathos-store.js — drop in the real Piraeus Bank account.
BANK_BENEFICIARY="PATHOS by Yeralis — Y. Yeralis"
BANK_NAME="Piraeus Bank"
BANK_IBAN="GR16 0110 1250 0000 0001 2345 678"
BANK_BIC="PIRBGRAA"
BANK_NOTE="Use your order number as the payment reference. We ship as soon as the deposit clears (usually 1–2 business days)."

# ── Optional ──
# A hero banner image URL for the storefront landing (falls back to a placeholder).
HERO_IMAGE_URL=""
